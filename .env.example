# Supabase configuration
# Copy these values into your local .env file.
SUPABASE_URL="https://your-project.supabase.co"

# SECRET -- bypasses all row-level security. Never commit a real value.
# Local dev: put it in .env / .dev.vars (both git-ignored).
# Deployment: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
# Never place it in wrangler.toml [vars] -- that block is plaintext.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Cloudflare / frontend configuration
# Set this when the frontend is served from Cloudflare Pages and the API sits on a separate domain.
VITE_API_BASE_URL=""

# Optional runtime limits
MAX_LISTINGS_PER_USER="20"

# ============================================================================
# DESTRUCTIVE. LEAVE THIS UNSET UNLESS YOU MEAN IT.
# ============================================================================
#
# Setting this to "true" makes the dev server (`npm run dev` / `npm start`) run
# a sweep on startup and every 6 hours that finds every listing created more
# than 90 days ago and PERMANENTLY DELETES its photos -- it sets image_url to
# null and image_urls to an empty array.
#
# This CANNOT BE UNDONE. Listing images are stored as base64 inside Postgres,
# so the row is the only copy of the photo. There is no object store holding a
# second copy and there is no backup.
#
# Worse: SUPABASE_URL above is the same project in .env, .dev.vars and
# wrangler.toml. There is no separate development database. Turning this on
# locally deletes photos from listings that real people are looking at.
#
# Unset (the default) means the sweep never runs. The dev server logs one line
# at startup confirming which state it is in.
#
# ENABLE_STALE_IMAGE_CLEANUP="true"
